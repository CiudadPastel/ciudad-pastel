GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/firebase-service-account.json
GOOGLE_CLOUD_PROJECT=your-firebase-project-id

PORT=3000
FRONTEND_URL=http://localhost:5173

# Required for student verification; generate a random secret of at least 32 bytes.
STUDENT_ACCESS_TOKEN_SECRET=

# Business WhatsApp configuration (CIU-154).
# Leave empty until the official number is confirmed (CIU-152).
# E.164 structure: + followed by 1-15 digits; first digit must be 1-9.
# Surrounding whitespace is trimmed; internal spaces/separators are invalid.
WHATSAPP_CONTACT_PHONE=

# Optional. Plain-text template with the exact {{productName}} placeholder.
# Surrounding whitespace is trimmed; maximum 1000 Unicode code points.
# Blank uses: Hola, quisiera información sobre {{productName}}.
# This default is provisional until CIU-152 is confirmed.
WHATSAPP_CONTACT_MESSAGE_TEMPLATE=
